<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>VisualMesas</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>GastroFlow</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.version>21.0.5</javafx.version>
        <postgresql.version>42.7.5</postgresql.version>
        <junit.version>5.11.4</junit.version>
        <jacoco.version>0.8.12</jacoco.version>

        <!--
            Taller de pruebas y metricas. Estos tres valores salen de la pagina
            del proyecto en https://sonarcloud.io una vez se importa el
            repositorio. El token no va aqui: va como secreto SONAR_TOKEN del
            repositorio en GitHub.
        -->
        <sonar.organization>COMPLETAR</sonar.organization>
        <sonar.projectKey>COMPLETAR</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencies>
        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- PostgreSQL (JDBC) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- BCrypt para almacenamiento seguro de contraseñas -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <!--
                        Clases que todavia usan Spring Data JPA y jakarta.persistence.
                        El proyecto quedo definido con JDBC en el PR #172 y esas
                        dependencias salieron del pom, asi que estas clases no compilan.
                        Se excluyen del build para no perderlas: siguen en el repositorio
                        y se van sacando de esta lista a medida que se migren a JDBC.
                    -->
                    <excludes>
                            <exclude>controller/PagoController.java</exclude>
                            <exclude>entity/Mesero.java</exclude>
                            <exclude>entity/Pago.java</exclude>
                            <exclude>repository/DetallePedidoRepository.java</exclude>
                            <exclude>repository/MeseroRepository.java</exclude>
                            <exclude>repository/PagoRepository.java</exclude>
                            <exclude>service/PagoService.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!--
                Taller de pruebas y metricas: informe HTML de resultados.
                Se genera con 'mvn surefire-report:report-only' despues de
                'mvn test' y queda en target/site/surefire-report.html.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!--
                Taller de pruebas y metricas: cobertura. El agente se engancha
                antes de las pruebas y el reporte se escribe al terminar la
                fase test, en target/site/jacoco (HTML para leerlo y XML para
                que SonarCloud lo lea).
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
