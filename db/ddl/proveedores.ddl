-- =============================================================================
-- TABLA: proveedores
-- HU-137: catálogo de proveedores (deja de guardarse solo como texto en ingredientes)
-- =============================================================================

CREATE TABLE proveedores (
                             proveedor_id     BIGINT GENERATED BY DEFAULT AS IDENTITY,
                             nombre           VARCHAR(150) NOT NULL,
                             telefono         VARCHAR(30),
                             correo           VARCHAR(150),
                             direccion        VARCHAR(250),
                             fecha_creacion   TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

                             CONSTRAINT pk_proveedores PRIMARY KEY (proveedor_id),
                             CONSTRAINT uq_proveedores_nombre UNIQUE (nombre)
);