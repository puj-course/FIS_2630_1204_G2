-- =============================================================================
-- TABLA: categoria_ingrediente
-- HU-137: catálogo de categorías de insumo (distinto de categorias de producto)
-- =============================================================================

CREATE TABLE categoria_ingrediente (
                                       categoria_ingrediente_id  BIGINT GENERATED BY DEFAULT AS IDENTITY,
                                       nombre                    VARCHAR(100) NOT NULL,

                                       CONSTRAINT pk_categoria_ingrediente PRIMARY KEY (categoria_ingrediente_id),
                                       CONSTRAINT uq_categoria_ingrediente_nombre UNIQUE (nombre)
);