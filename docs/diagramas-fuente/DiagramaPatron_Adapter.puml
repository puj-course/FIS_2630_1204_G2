interface ComandaCocina <<Target>> {
  +getNumero() String
  +getMesaId() Long
  +getMinutosEspera() long
  +getColumna() Columna
  +puedeAvanzar() boolean
  +getTextoAccion() String
  +avanzar() Pedido
}
class PedidoComandaAdapter <<Adapter>> {
  -pedido : Pedido
  +PedidoComandaAdapter(pedido : Pedido)
  +getNumero() String
  +getMesaId() Long
  +getMinutosEspera() long
  +getColumna() Columna
  +puedeAvanzar() boolean
  +getTextoAccion() String
  +avanzar() Pedido
}
class Pedido <<Adaptee>> {
  +getNumeroPedido() String
  +getMesaId() Long
  +getEstado() EstadoPedido
  +setEstado(estado : EstadoPedido) void
  +getFechaPedido() LocalDateTime
}
class CocinaController {
}
ComandaCocina <|.. PedidoComandaAdapter
PedidoComandaAdapter --> Pedido : pedido
CocinaController ..> PedidoComandaAdapter : new
CocinaController ..> ComandaCocina : avanzar, getColumna, getMesaId, getMinutosEspera, getNumero, getTextoAccion, puedeAvanzar
@enduml
