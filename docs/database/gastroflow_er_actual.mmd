  estados_mesa ||--o{ mesas : estado_actual
  mesas ||--o{ historial_estado_mesa : registra
  estados_mesa ||--o{ historial_estado_mesa : anterior_y_nuevo
  mesas ||--o| nota_mesa : tiene
  mesas ||--o{ reservas : recibe
  mesas ||--o{ asignacion_mesa : asignada
  usuarios ||--o{ asignacion_mesa : atiende
  mesas |o--o{ pedidos : origina
  clientes |o--o{ pedidos : pide
  usuarios ||--o{ pedidos : toma_y_cancela
  pedidos ||--o{ detalle_pedido : contiene
  productos ||--o{ detalle_pedido : vendido
  detalle_pedido ||--o{ detalle_pedido_adicional : lleva
  adicional ||--o{ detalle_pedido_adicional : aplicado
  pedidos ||--o{ pagos : se_cobra
  usuarios ||--o{ pagos : cobra
