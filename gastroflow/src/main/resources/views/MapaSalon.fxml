<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<Pane fx:id="panelMesas" prefHeight="580.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MapaSalonController">
   <children>
      <VBox fx:id="leyendaEstados" layoutX="24.0" layoutY="18.0" prefWidth="220.0" spacing="6.0" />
      <VBox layoutX="250.0" layoutY="18.0" prefWidth="176.0" spacing="4.0" style="-fx-border-color: #D0D0D0; -fx-border-radius: 6; -fx-padding: 8;">
         <children>
            <Label fx:id="tituloDetalleMesa" style="-fx-font-weight: bold;" text="Seleccione una mesa" />
            <Label fx:id="detalleNumero" text="Numero: -" />
            <Label fx:id="detalleEstado" text="Estado: -" />
            <Label fx:id="detalleCapacidad" text="Capacidad maxima: -" wrapText="true" />
            <Label fx:id="detalleComensales" text="Comensales: -" wrapText="true" />
            <Label fx:id="detallePedido" text="Pedido activo: -" wrapText="true" />
            <Label fx:id="detalleMesero" text="Mesero responsable: -" wrapText="true" />
            <Label fx:id="detalleCodigo" text="Codigo: -" wrapText="true" />
         </children>
      </VBox>
      <HBox layoutX="24.0" layoutY="150.0" spacing="8.0">
         <children>
            <ToggleButton fx:id="filtroTodas" mnemonicParsing="false" prefWidth="84.0" text="Todas" />
            <ToggleButton fx:id="filtroLibres" mnemonicParsing="false" prefWidth="84.0" text="Libres" />
            <ToggleButton fx:id="filtroOcupadas" mnemonicParsing="false" prefWidth="92.0" text="Ocupadas" />
            <ToggleButton fx:id="filtroReservadas" mnemonicParsing="false" prefWidth="104.0" text="Reservadas" />
         </children>
      </HBox>
      <Label fx:id="mensajeFiltro" layoutX="24.0" layoutY="184.0" prefWidth="400.0" textFill="#B00020" visible="false" />
      <Button alignment="CENTER" layoutX="24.0" layoutY="530.0" mnemonicParsing="false" onAction="#agregarMesa" prefHeight="30.0" prefWidth="150.0" text="Agregar Mesa" />
      <Button alignment="CENTER" layoutX="276.0" layoutY="530.0" mnemonicParsing="false" onAction="#quitarMesa" prefHeight="30.0" prefWidth="150.0" text="Quitar Mesa" />
   </children>
</Pane>
