<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gastroflow.controller.CajeroPagoController">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="header">
            <VBox spacing="6">
                <Label text="Gestión de cuenta" styleClass="titulo"/>
                <Label text="Propina voluntaria y descuentos" styleClass="subtitulo"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT">
                <Label text="Cajero" styleClass="subtitulo"/>
                <Label fx:id="cajeroLabel" text="-" styleClass="valor"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="18" styleClass="contenido">

                <HBox spacing="10">
                    <TextField fx:id="numeroPedidoField"
                               promptText="Número de pedido"
                               HBox.hgrow="ALWAYS"/>
                    <Button fx:id="buscarPedidoButton" text="Buscar cuenta" onAction="#buscarPedido"/>
                </HBox>

                <GridPane hgap="18" vgap="14" styleClass="tarjeta">
                    <columnConstraints>
                        <ColumnConstraints minWidth="180"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Estado de cuenta" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="estadoCuentaLabel" styleClass="valor" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Pedido" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="pedidoLabel" styleClass="valor" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Mesa" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="mesaLabel" styleClass="valor" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Subtotal" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="subtotalLabel" styleClass="valor" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Impuestos" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <Label fx:id="impuestosLabel" styleClass="valor" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <VBox spacing="12" styleClass="tarjeta">
                    <Label text="Descuento autorizado" styleClass="seccion"/>
                    <HBox spacing="10">
                        <TextField fx:id="descuentoField" promptText="0.00" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="eliminarDescuentoButton" text="Eliminar descuento" onAction="#eliminarDescuento"/>
                    </HBox>
                    <TextField fx:id="motivoDescuentoField"
                               promptText="Motivo del descuento (obligatorio si aplica descuento)"/>
                </VBox>

                <VBox spacing="12" styleClass="tarjeta">
                    <Label text="Propina voluntaria" styleClass="seccion"/>
                    <HBox spacing="10">
                        <TextField fx:id="propinaField" promptText="0.00" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="eliminarPropinaButton" text="Eliminar propina" onAction="#eliminarPropina"/>
                    </HBox>
                </VBox>

                <VBox spacing="10" styleClass="tarjeta">
                    <Label text="Resumen antes del pago" styleClass="seccion"/>
                    <GridPane hgap="18" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="180"/>
                            <ColumnConstraints hgrow="ALWAYS" halignment="RIGHT"/>
                        </columnConstraints>

                        <Label text="Subtotal" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="subtotalResumenLabel" styleClass="valor" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Impuestos" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="impuestosResumenLabel" styleClass="valor" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Descuento" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="descuentoResumenLabel" styleClass="valor" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Propina" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="propinaResumenLabel" styleClass="valor" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="18" styleClass="total-container">
                    <Label text="TOTAL A PAGAR" styleClass="total-titulo"/>
                    <Label fx:id="totalLabel" text="$0" styleClass="total-valor"/>
                </HBox>

                <Button fx:id="cerrarPagoButton"
                        text="Cerrar pago"
                        maxWidth="Infinity"
                        onAction="#cerrarPago"
                        styleClass="boton-principal"/>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
